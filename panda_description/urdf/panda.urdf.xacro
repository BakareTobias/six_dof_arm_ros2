<?xml version="1.0"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="is_ignition" default="false"/>
  <xacro:arg name="use_gazebo_sim" default="true"/>


  <xacro:include filename="$(find panda_description)/urdf/common_properties.urdf.xacro" />
  <xacro:include filename="$(find panda_description)/urdf/arm.xacro" />
  <xacro:include filename="$(find panda_description)/urdf/sensors.xacro" />
  <xacro:include filename="$(find panda_description)/urdf/gazebo.xacro" />

  <xacro:if value="$(arg use_gazebo_sim)">
      <xacro:include filename="$(find panda_description)/urdf/panda_.ros2_control.xacro" />
  </xacro:if>
  <xacro:unless value="$(arg use_gazebo_sim)">
      <xacro:include filename="$(find panda_description)/urdf/panda.ros2_control.xacro" />
  </xacro:unless>

      
</robot>
